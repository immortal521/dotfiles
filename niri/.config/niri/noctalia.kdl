layout {

    focus-ring {
        active-color   "#ffb0ce"
        inactive-color "#1d100a"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb0ce"
        inactive-color "#1d100a"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb0ce"
        inactive-color "#79294f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb0ce80"
    }
}

recent-windows {
    highlight {
        active-color "#ffb0ce"
        urgent-color "#ffb4ab"
    }
}
